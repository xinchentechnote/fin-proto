// base on reference/Ouch5.0.pdf
// NASDAQ OUCH 5.0 Order Entry Specification (Updated April, 2023).
// 传输层: 消息由 SoupBinTCP 承载, SoupBinTCP 帧封装(2字节长度+1字节类型+负载)
// 不属于消息层, 本文件不建模。
// 方向说明: OUCH Inbound(客户->主机, spec section 2) 与 Outbound(主机->客户,
// spec section 3) 使用同一个字节的 alpha 消息类型, 且存在同字符冲突
// ('U','C','D','E','X','M','Q'), 单一 match 无法按方向区分, 因此定义两个分发器:
//   - packet OuchInbound        客户 -> 主机 (Inbound Messages)
//   - root packet OuchOutbound  主机 -> 客户 (Outbound Messages)
// 每条消息首字节为消息类型(由分发器的 MsgType 字段消耗), 各消息 packet 只包含
// 类型字节之后的字段: PDF 表格 Offset=N 的字段对应 packet 内偏移 N-1。
// 数据类型: Numeric 为大端二进制无符号整数(Long 8字节/Integer 4字节);
// Alpha 左对齐右补空格(char[n]); Price 为 8 字节整数, 隐含 4 位小数,
// 最大 $199,999.9900; Timestamp 为自当日午夜起的纳秒数。
// 语法缺口(无法表达, 已绕行): 消息尾部可选的 Optional Appendage 由若干
// TagValue 元素(Length u8 + OptionTag u8 + 变长 value)串联组成, 属
// "重复到消息尾"结构, 当前 DSL 无条件可选字段/重复到尾语义, 不建模;
// 各消息仅保留 AppendageLength 字段(u16)以维持与 PDF 一致的偏移。
// 另注: 部分消息的 Appendage Length/Optional Appendage 为"可选出现"
// (Cancel/Modify/Account Query 等), 同样无法条件表达, 本文件一律按存在建模。
options {
    StringPrefixLenType = u8;
    ArrayPrefixLenType = u16;
    LittleEndian = false;
    JavaPackage = "com.finproto.nasdaq.ouch.messages";
    GoPackage = "nasdaq_ouch";
    GoModule = "github.com/xinchentechnote/fin-proto-go/nasdaq-ouch/messages";
}

MetaData Types {
    uint64 Price `价格, 8字节大端无符号整数, 隐含4位小数, 0x7FFFFFFF 表示市价`,
    uint64 Timestamp `时间戳, 自当日午夜起的纳秒数, 8字节大端无符号整数`,
}

// =====================================================================
// Inbound Messages (客户 -> 主机), spec section 2
// =====================================================================

// 2.1 Type 'O' - Enter Order, PDF p.4-5, 定长 47 字节(含类型字节, 不含 Appendage)。
packet EnterOrderMessage {
    uint32 UserRefNum `用户参考号, 日内唯一且严格递增, offset 1`,
    char[1] Side `方向: B=买 S=卖 T=卖空 E=卖空豁免, offset 5`,
    uint32 Quantity `股数, 大于0且小于1,000,000, offset 6`,
    char[8] Symbol `证券代码, 左对齐右补空格, offset 10`,
    Price Price `价格, 隐含4位小数, offset 18`,
    char[1] TimeInForce `有效期: 0=Day 3=IOC 5=GTX 6=GTT(需ExpireTime) E=盘后, offset 26`,
    char[1] Display `显示: Y=可见 N=隐藏 A=可归属, offset 27`,
    char[1] Capacity `身份: A=代理 P=自营 R=无风险 O=其他, offset 28`,
    char[1] InterMarketSweepEligibility `跨市场扫单资格: Y=是 N=否, offset 29`,
    char[1] CrossType `集合竞价类型: N=连续 O=开盘 C=收盘 H=停牌/IPO S=补充 R=零售 E=延生 A=盘后收盘, offset 30`,
    char[14] ClOrdID `客户订单标识, 不校验日内唯一, offset 31`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 45`,
}

// 2.2 Type 'U' - Replace Order Request, PDF p.6-7, 定长 40 字节(不含 Appendage)。
packet ReplaceOrderMessage {
    uint32 OrigUserRefNum `被替换订单的用户参考号, offset 1`,
    uint32 UserRefNum `替换订单的新用户参考号, 必须唯一且严格递增, offset 5`,
    uint32 Quantity `责任股数, 含链上已成交与自营撮合防御扣减, offset 9`,
    Price Price `替换订单价格, offset 13`,
    char[1] TimeInForce `有效期, 同 Enter Order, offset 21`,
    char[1] Display `显示: Y=可见 N=隐藏 A=可归属, offset 22`,
    char[1] InterMarketSweepEligibility `跨市场扫单资格: Y=是 N=否, offset 23`,
    char[14] ClOrdID `替换订单的客户订单标识, offset 24`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 38`,
}

// 2.3 Type 'X' - Cancel Order Request, PDF p.7-8, 定长 11 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet CancelOrderMessage {
    uint32 UserRefNum `订单用户参考号, offset 1`,
    uint32 Quantity `新的预期订单余量, 0 表示撤销全部剩余, offset 5`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 9`,
}

// 2.4 Type 'M' - Modify Order Request, PDF p.8, 定长 12 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet ModifyOrderMessage {
    uint32 UserRefNum `订单用户参考号, offset 1`,
    char[1] Side `新方向: 仅允许 B<->E/T 方向组合修改, offset 5`,
    uint32 Quantity `新的预期订单余量, 0 表示撤销全部剩余, offset 6`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 10`,
}

// 2.5 Type 'C' - Mass Cancel Request, PDF p.9, 定长 19 字节(不含 Appendage)。
packet MassCancelMessage {
    uint32 UserRefNum `用户参考号, 日内唯一且严格递增, offset 1`,
    char[4] Firm `会员 firm 标识, 全大写, offset 5`,
    char[8] Symbol `证券代码, 可选, 未指定时右补空格, offset 9`,
    uint16 AppendageLength `可选附加段长度, 无附加段时为0, offset 17`,
}

// 2.6 Type 'D' - Disable Order Entry Request, PDF p.9-10, 定长 11 字节(不含 Appendage)。
packet DisableOrderEntryMessage {
    uint32 UserRefNum `用户参考号, 日内唯一且严格递增, offset 1`,
    char[4] Firm `会员 firm 标识, 全大写, offset 5`,
    uint16 AppendageLength `可选附加段长度, offset 9`,
}

// 2.7 Type 'E' - Enable Order Entry Request, PDF p.10, 定长 11 字节(不含 Appendage)。
packet EnableOrderEntryMessage {
    uint32 UserRefNum `用户参考号, 日内唯一且严格递增, offset 1`,
    char[4] Firm `会员 firm 标识, 全大写, offset 5`,
    uint16 AppendageLength `可选附加段长度, offset 9`,
}

// 2.8 Type 'Q' - Account Query Request, PDF p.10, 定长 3 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet AccountQueryMessage {
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 1`,
}

// =====================================================================
// Outbound Messages (主机 -> 客户), spec section 3
// =====================================================================

// 3.1 Type 'S' - System Event, PDF p.10-11, 定长 10 字节。
packet SystemEventMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    char[1] EventCode `事件: S=开始OfDay E=结束OfDay, offset 9`,
}

// 3.2 Type 'A' - Order Accepted, PDF p.11-12, 定长 64 字节(不含 Appendage)。
packet OrderAcceptedMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `下单时的用户参考号, offset 9`,
    char[1] Side `方向, offset 13`,
    uint32 Quantity `接受的股数, offset 14`,
    char[8] Symbol `证券代码, offset 18`,
    Price Price `接受价格, 可能被交易所改价, offset 26`,
    char[1] TimeInForce `接受的有效期, offset 34`,
    char[1] Display `显示: Y=可见 N=隐藏 A=可归属 Z=合规, offset 35`,
    uint64 OrderReferenceNumber `交易所分配的日内唯一订单引用号, offset 36`,
    char[1] Capacity `身份, offset 44`,
    char[1] InterMarketSweepEligibility `跨市场扫单资格: Y=是 N=否, offset 45`,
    char[1] CrossType `集合竞价类型, offset 46`,
    char[1] OrderState `订单状态: L=活跃 D=已死(接受即自动撤销), offset 47`,
    char[14] ClOrdID `客户订单标识, offset 48`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 62`,
}

// 3.3 Type 'U' - Order Replaced, PDF p.13, 定长 68 字节(不含 Appendage)。
packet OrderReplacedMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 OrigUserRefNum `被替换订单的用户参考号, offset 9`,
    uint32 UserRefNum `替换订单的用户参考号, offset 13`,
    char[1] Side `方向, offset 17`,
    uint32 Quantity `替换完成后剩余股数, offset 18`,
    char[8] Symbol `证券代码, offset 22`,
    Price Price `接受价格, offset 30`,
    char[1] TimeInForce `接受的有效期, offset 38`,
    char[1] Display `显示: Y=可见 N=隐藏 A=可归属 Z=合规, offset 39`,
    uint64 OrderReferenceNumber `交易所分配的日内唯一订单引用号, offset 40`,
    char[1] Capacity `身份, offset 48`,
    char[1] InterMarketSweepEligibility `跨市场扫单资格: Y=是 N=否, offset 49`,
    char[1] CrossType `集合竞价类型, offset 50`,
    char[1] OrderState `订单状态: L=活跃 D=已死, offset 51`,
    char[14] ClOrdID `替换订单的客户订单标识, offset 52`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 66`,
}

// 3.4 Type 'C' - Order Canceled, PDF p.14, 定长 20 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet OrderCanceledMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被(部分)撤销订单的用户参考号, offset 9`,
    uint32 Quantity `本次撤销股数, 增量而非累计, offset 13`,
    char[1] Reason `撤销原因, 见规范 Appendix B, offset 17`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 18`,
}

// 3.5 Type 'D' - AIQ Canceled, PDF p.14-15, 定长 34 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet AIQCanceledMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被扣减订单的用户参考号, offset 9`,
    uint32 DecrementShares `本次扣减股数, 增量, offset 13`,
    char[1] Reason `AIQ 撤销原因, 恒为 Q, offset 17`,
    uint32 QuantityPreventedFromTrading `因 AIQ 被阻止成交的股数, offset 18`,
    Price ExecutionPrice `本应成交的价格, offset 22`,
    char[1] LiquidityFlag `本应获得的流动性标志, 见规范 Appendix D, offset 30`,
    char[1] AIQStrategy `AIQ 策略, offset 31`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 32`,
}

// 3.6 Type 'E' - Order Executed, PDF p.15, 定长 36 字节(不含 Appendage)。
packet OrderExecutedMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被成交订单的用户参考号, offset 9`,
    uint32 Quantity `本次成交股数, 增量, offset 13`,
    Price Price `成交价, offset 17`,
    char[1] LiquidityFlag `流动性标志, 见规范 Appendix D, offset 25`,
    uint64 MatchNumber `成交匹配号, 买卖双方相同, offset 26`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 34`,
}

// 3.7 Type 'B' - Broken Trade, PDF p.15-16, 定长 38 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet BrokenTradeMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被 break 成交所属订单的用户参考号, offset 9`,
    uint64 MatchNumber `被 break 的成交匹配号, offset 13`,
    char[1] Reason `break 原因: E=错单 C=协商 S=监管 X=外部, offset 21`,
    char[14] ClOrdID `客户订单标识, offset 22`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 36`,
}

// 3.8 Type 'J' - Rejected, PDF p.16, 定长 31 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet RejectedOrderMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被拒绝订单的用户参考号, 不可复用, offset 9`,
    uint16 Reason `拒绝原因码, 见规范 Appendix C, offset 13`,
    char[14] ClOrdID `被拒绝订单的客户订单标识, offset 15`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 29`,
}

// 3.9 Type 'P' - Cancel Pending, PDF p.16-17, 定长 15 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet CancelPendingMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `待撤销订单的用户参考号, offset 9`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 13`,
}

// 3.10 Type 'I' - Cancel Reject, PDF p.17, 定长 15 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet CancelRejectMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被拒绝撤销的订单用户参考号, offset 9`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 13`,
}

// 3.11 Type 'T' - Order Priority Update, PDF p.17-18, 定长 32 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet OrderPriorityUpdateMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `优先级被更新订单的用户参考号, offset 9`,
    Price Price `订单限价, offset 13`,
    char[1] Display `新显示属性: Y=匿名-价格遵从, offset 21`,
    uint64 OrderReferenceNumber `因优先级更新而新分配的订单引用号, offset 22`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 30`,
}

// 3.12 Type 'M' - Order Modified, PDF p.18, 定长 20 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet OrderModifiedMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被修改订单的用户参考号, offset 9`,
    char[1] Side `Modify Request 中的方向, offset 13`,
    uint32 Quantity `修改后剩余股数, offset 14`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 18`,
}

// 3.13 Type 'R' - Order Restated, PDF p.18-19, 定长 16 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet OrderRestatedMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `被重述订单的用户参考号, offset 9`,
    char[1] Reason `重述原因: R=显示刷新(储备单) P=显示价更新, offset 13`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 14`,
}

// 3.14 Type 'X' - Mass Cancel Response, PDF p.19, 定长 27 字节(不含 Appendage)。
packet MassCancelResponseMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `Inbound 消息中的用户参考号, offset 9`,
    char[4] Firm `会员 firm 标识, 全大写, offset 13`,
    char[8] Symbol `证券代码, 可选, 未指定时右补空格, offset 17`,
    uint16 AppendageLength `可选附加段长度, 无附加段时为0, offset 25`,
}

// 3.15 Type 'G' - Disable Order Entry Response, PDF p.19-20, 定长 19 字节(不含 Appendage)。
packet DisableOrderEntryResponseMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `Inbound 消息中的用户参考号, offset 9`,
    char[4] Firm `会员 firm 标识, 全大写, offset 13`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 17`,
}

// 3.16 Type 'K' - Enable Order Entry Response, PDF p.20, 定长 19 字节(不含 Appendage)。
packet EnableOrderEntryResponseMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 UserRefNum `Inbound 消息中的用户参考号, offset 9`,
    char[4] Firm `会员 firm 标识, 全大写, offset 13`,
    uint16 AppendageLength `可选附加段长度, 附加段内容不建模(语法缺口), offset 17`,
}

// 3.17 Type 'Q' - Account Query Response, PDF p.20, 定长 15 字节(不含 Appendage)。
// 注意: 规范说明本消息的 Appendage Length/Optional Appendage 是可选的。
packet AccountQueryResponseMessage {
    Timestamp Timestamp `时间戳, 纳秒, offset 1`,
    uint32 NextUserRefNum `下一个可用用户参考号, offset 9`,
    uint16 AppendageLength `可选附加段长度(本消息可选), 附加段内容不建模, offset 13`,
}

// =====================================================================
// Dispatchers (方向分发器)
// =====================================================================

// Inbound 分发器: 每条 Inbound 消息以 1 字节消息类型开头 (spec section 2)。
packet OuchInbound {
    char[1] MsgType `消息类型字符`,
    match MsgType as Body {
        "O" : EnterOrderMessage,
        "U" : ReplaceOrderMessage,
        "X" : CancelOrderMessage,
        "M" : ModifyOrderMessage,
        "C" : MassCancelMessage,
        "D" : DisableOrderEntryMessage,
        "E" : EnableOrderEntryMessage,
        "Q" : AccountQueryMessage,
    },
}

// Outbound 分发器(根): 每条 Outbound 消息以 1 字节消息类型开头 (spec section 3)。
root packet OuchOutbound {
    char[1] MsgType `消息类型字符`,
    match MsgType as Body {
        "S" : SystemEventMessage,
        "A" : OrderAcceptedMessage,
        "U" : OrderReplacedMessage,
        "C" : OrderCanceledMessage,
        "D" : AIQCanceledMessage,
        "E" : OrderExecutedMessage,
        "B" : BrokenTradeMessage,
        "J" : RejectedOrderMessage,
        "P" : CancelPendingMessage,
        "I" : CancelRejectMessage,
        "T" : OrderPriorityUpdateMessage,
        "M" : OrderModifiedMessage,
        "R" : OrderRestatedMessage,
        "X" : MassCancelResponseMessage,
        "G" : DisableOrderEntryResponseMessage,
        "K" : EnableOrderEntryResponseMessage,
        "Q" : AccountQueryResponseMessage,
    },
}
