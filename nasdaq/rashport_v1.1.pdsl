// base on reference/rash_sb.pdf
// NASDAQ RASHport (RASH) Version 1.1 (Updated July, 2024).
// 传输层: 消息由 SoupTCP(SoupBinTCP) 承载, 帧封装不属于消息层, 本文件不建模。
// 方向说明: RASH Inbound(客户->主机, spec section 2) 与 Outbound(主机->客户,
// spec section 3) 使用同一个字节的 alpha 消息类型且布局不同, 因此定义两个分发器:
//   - packet RashInbound        客户 -> 主机 (Inbound Messages)
//   - root packet RashOutbound  主机 -> 客户 (Outbound Messages)
// 消息布局差异(按 PDF 原文): Inbound 消息首字节(offset 0)为消息类型;
// Outbound 消息前 8 字节为 Timestamp, 消息类型字符位于 offset 8。
// 数据类型(按 PDF 1.2): 协议无二进制数值 - 所有 Numeric 字段都是 ASCII 数字串,
// 右对齐左补 '0', 全部用 char[n] 建模; Alpha 字段左对齐右补空格;
// Price 为 10 字符, 整数 6 位 + 小数 4 位(小数点隐含); Timestamp 为
// 自午夜起的毫秒数(ET), 8 字符。每条消息定长。
// 存疑点(PDF 提取文本自相矛盾, 已按最合理方案处理):
//  1) 3.2.8 Trade Correction 表格 Timestamp 标注 offset 1 / Message Type 标注
//     offset 0, 与其余全部 Outbound 消息(Timestamp 0 / Type 8)相反, 判定为
//     表格排版/提取错误, 按 Timestamp 0(8字节) / Type 8(1字节) 建模;
//  2) 2.3 Cancel Order 表格 Shares 行之后有一行无字段名的 "139 1 Alpha"
//     残片, 判定为提取残渣, 未建模(仅 Type/Token/Shares 三个名字段)。
options {
    StringPrefixLenType = u8;
    ArrayPrefixLenType = u16;
    LittleEndian = false;
    JavaPackage = "com.finproto.nasdaq.rash.messages";
    GoPackage = "nasdaq_rash";
    GoModule = "github.com/xinchentechnote/fin-proto-go/nasdaq-rash/messages";
}

MetaData Types {
    char[8] Timestamp `时间戳, ASCII 数字, 自午夜起的毫秒数(ET), 右对齐左补0`,
    char[10] Price `价格, ASCII 数字, 整数6位+小数4位隐含小数点, 右对齐左补0`,
    char[14] OrderToken `订单令牌, 字母数字, 每个 RASH 账户日内唯一, 左对齐`,
    char[9] MatchNumber `成交匹配号, ASCII 数字, 右对齐左补0`,
}

// =====================================================================
// Inbound Messages (客户 -> 主机), spec section 2
// 消息类型字符位于 offset 0, 各消息 packet 包含 offset 1 起的字段。
// =====================================================================

// 2.1 Type 'O' - Enter Order, PDF p.4-5, 定长 141 字节。
packet EnterOrderMessage {
    OrderToken OrderToken `订单令牌, 日内唯一, offset 1`,
    char[1] Side `B/S/T/E 买/卖/卖空/卖空豁免, offset 15`,
    char[6] Shares `股数, 必须大于0, offset 16`,
    char[8] StockSymbol `证券代码, offset 22`,
    Price Price `价格 6.4 隐含小数, offset 30`,
    char[5] TimeInForce `存活秒数, 特殊值见 2.1.1(0=IOC 99960..99999), offset 40`,
    char[4] Firm `MPID / 客户 ID, offset 45`,
    char[1] Display `显示: Y/N/A/I/P/W/L/M/B/C/c/d, offset 49`,
    char[6] MinQty `最小成交数量, offset 50`,
    char[6] MaxFloor `最大显示股数, 0 时默认为订单股数, offset 56`,
    char[1] PegType `锚定类型: M=中间价 N=不锚定 P=市价 R=对手价 Q=做市商 I=INAV, offset 62`,
    char[1] PegDifferenceSign `锚定差符号 +/-, N 锚定时填 +, offset 63`,
    Price PegDifference `锚定差 6.4, N 锚定时填 0, offset 64`,
    Price DiscretionPrice ` discretion 价格 6.4, 0 表示无 discretion, offset 74`,
    char[1] DiscretionPegType ` discretion 锚定类型: M/N/P/R/I, offset 84`,
    char[1] DiscretionPegDifferenceSign ` discretion 锚定差符号 +/-, offset 85`,
    Price DiscretionPegDifference ` discretion 锚定差 6.4, offset 86`,
    char[1] Capacity ` Capacity / Rule 80A 标志, offset 96`,
    char[6] RandomReserve `随机储备股数, 必须小于 MaxFloor, offset 97`,
    char[4] RouteDest `路由目的地/执行经纪(INET/DOTA/...), offset 103`,
    char[32] CustTerminalID `客户/终端 ID/发送方子 ID, 左对齐, offset 107`,
    char[1] CustomerType `客户类型(可选): R=零售指定 N=非零售, offset 139`,
    char[1] TradeNow `是否 Trade Now(可选): B=是 N=否, offset 140`,
}

// 2.2 Type 'Q' - Enter Order with Cross functionality, PDF p.6-8, 定长 143 字节。
packet EnterOrderWithCrossMessage {
    OrderToken OrderToken `订单令牌, 日内唯一, offset 1`,
    char[1] Side `B/S/T/E 买/卖/卖空/卖空豁免, offset 15`,
    char[6] Shares `股数, 必须大于0, offset 16`,
    char[8] StockSymbol `证券代码, offset 22`,
    Price Price `价格 6.4 隐含小数, offset 30`,
    char[5] TimeInForce `存活秒数, 特殊值见 2.1.1(含 99996), offset 40`,
    char[4] Firm `MPID / 客户 ID, offset 45`,
    char[1] Display `显示: Y/N/A/I/P/W/L/M/B/C/c/d/O/T/Q, offset 49`,
    char[6] MinQty `最小成交数量, offset 50`,
    char[6] MaxFloor `最大显示股数, 0 时默认为订单股数, offset 56`,
    char[1] PegType `锚定类型: M/N/P/R/Q/I, offset 62`,
    char[1] PegDifferenceSign `锚定差符号 +/-, offset 63`,
    Price PegDifference `锚定差 6.4, offset 64`,
    Price DiscretionPrice ` discretion 价格 6.4, 0 表示无 discretion, offset 74`,
    char[1] DiscretionPegType ` discretion 锚定类型: M/N/P/R/I, offset 84`,
    char[1] DiscretionPegDifferenceSign ` discretion 锚定差符号 +/-, offset 85`,
    Price DiscretionPegDifference ` discretion 锚定差 6.4, offset 86`,
    char[1] Capacity ` Capacity / Rule 80A 标志, offset 96`,
    char[6] RandomReserve `随机储备股数, offset 97`,
    char[4] RouteDest `路由目的地/执行经纪, offset 103`,
    char[32] CustTerminalID `客户/终端 ID/发送方子 ID, 左对齐, offset 107`,
    char[1] IntermarketSweepEligibility `跨市场扫单: Y=是 N=否 y=Trade-at ISO, offset 139`,
    char[1] CrossType `竞价类型: O=开盘 C=收盘 N=立即 R=零售 E=延生 A=盘后收盘, offset 140`,
    char[1] CustomerType `客户类型(可选): R=零售指定 N=非零售, offset 141`,
    char[1] TradeNow `是否 Trade Now(可选): B=是 N=否, offset 142`,
}

// 2.3 Type 'X' - Cancel Order, PDF p.8, 定长 21 字节。
// PDF 表格 Shares 行后有一行无字段名的 "139 1 Alpha" 残片, 判定为提取残渣未建模。
packet CancelOrderMessage {
    OrderToken OrderToken `原 Enter Order 中的订单令牌, offset 1`,
    char[6] Shares `0 表示整单撤销, 否则为新的预期订单余量, offset 15`,
}

// =====================================================================
// Outbound Messages (主机 -> 客户), spec section 3
// 前 8 字节为 Timestamp, 消息类型字符位于 offset 8,
// 各消息 packet 包含 offset 9 起的字段。
// =====================================================================

// 3.1 Type 'S' - System Event, PDF p.9, 定长 10 字节。
packet SystemEventMessage {
    char[1] EventCode `事件: S=开始OfDay E=结束OfDay, offset 9`,
}

// 3.2.1 Type 'A' - Accepted Order, PDF p.9-10, 定长 156 字节。
packet OrderAcceptedMessage {
    OrderToken OrderToken `订单令牌, offset 9`,
    char[1] Side `B/S/T/E 买/卖/卖空/卖空豁免, offset 23`,
    char[6] Shares `接受的股数, offset 24`,
    char[8] StockSymbol `证券代码, offset 30`,
    Price Price `价格 6.4 隐含小数, offset 38`,
    char[5] TimeInForce `秒数(OUCH 兼容), offset 48`,
    char[4] Firm `MPID / 客户 ID, offset 53`,
    char[1] Display `显示: Y/N/A/I/P/W/L/M/B/C/c/d, offset 57`,
    char[9] OrderReferenceNumber `交易所分配的日内唯一订单引用号, offset 58`,
    char[6] MinQty `最小成交数量, offset 67`,
    char[6] MaxFloor `最大显示股数, offset 73`,
    char[1] PegType `锚定类型: M/N/P/R/Q/I, offset 79`,
    char[1] PegDifferenceSign `锚定差符号 +/-, offset 80`,
    Price PegDifference `锚定差 6.4, offset 81`,
    Price DiscretionPrice ` discretion 价格 6.4, offset 91`,
    char[1] DiscretionPegType ` discretion 锚定类型: M/N/P/R/I, offset 101`,
    char[1] DiscretionPegDifferenceSign ` discretion 锚定差符号 +/-, offset 102`,
    Price DiscretionPegDifference ` discretion 锚定差 6.4, offset 103`,
    char[1] Capacity ` Capacity / Rule 80A 标志, offset 113`,
    char[6] RandomReserve `随机储备股数, offset 114`,
    char[4] RouteDest `路由目的地/执行经纪, offset 120`,
    char[32] CustTerminalID `客户/终端 ID/发送方子 ID, offset 124`,
}

// 3.2.2 Type 'R' - Accepted Order with Cross functionality, PDF p.10-12,
// 定长 158 字节。同 'A' 消息外加末尾 2 个字段; 规范注明 'R' 可用于所有订单类型。
packet OrderAcceptedWithCrossMessage {
    OrderToken OrderToken `订单令牌, offset 9`,
    char[1] Side `B/S/T/E 买/卖/卖空/卖空豁免, offset 23`,
    char[6] Shares `接受的股数, offset 24`,
    char[8] StockSymbol `证券代码, offset 30`,
    Price Price `价格 6.4 隐含小数, offset 38`,
    char[5] TimeInForce `秒数(OUCH 兼容), offset 48`,
    char[4] Firm `MPID / 客户 ID, offset 53`,
    char[1] Display `显示: Y/N/A/I/P/W/L/M/B/C/c/d/O/T/Q, offset 57`,
    char[9] OrderReferenceNumber `交易所分配的日内唯一订单引用号, offset 58`,
    char[6] MinQty `最小成交数量, offset 67`,
    char[6] MaxFloor `最大显示股数, offset 73`,
    char[1] PegType `锚定类型: M/N/P/R/Q/I, offset 79`,
    char[1] PegDifferenceSign `锚定差符号 +/-, offset 80`,
    Price PegDifference `锚定差 6.4, offset 81`,
    Price DiscretionPrice ` discretion 价格 6.4, offset 91`,
    char[1] DiscretionPegType ` discretion 锚定类型: M/N/P/R/I, offset 101`,
    char[1] DiscretionPegDifferenceSign ` discretion 锚定差符号 +/-, offset 102`,
    Price DiscretionPegDifference ` discretion 锚定差 6.4, offset 103`,
    char[1] Capacity ` Capacity / Rule 80A 标志, offset 113`,
    char[6] RandomReserve `随机储备股数, offset 114`,
    char[4] RouteDest `路由目的地/执行经纪, offset 120`,
    char[32] CustTerminalID `客户/终端 ID/发送方子 ID, offset 124`,
    char[1] IntermarketSweepEligibility `跨市场扫单: Y=是 N=否 y=Trade-at ISO, offset 156`,
    char[1] CrossType `竞价类型: O=开盘 C=收盘 I=日内 N=立即 E=延生 A=盘后收盘, offset 157`,
}

// 3.2.3 Type 'C' - Canceled Order, PDF p.12, 定长 30 字节。
packet OrderCanceledMessage {
    OrderToken OrderToken `原订单令牌, offset 9`,
    char[6] Shares `被撤销股数, offset 23`,
    char[1] Reason `撤销原因(U/I/T/S/D/Q/Z/C/q/K/H/X/E/J/A/F/G), offset 29`,
}

// 3.2.4 Type 'J' - Rejected Order, PDF p.13, 定长 24 字节。
packet OrderRejectedMessage {
    OrderToken OrderToken `被拒绝订单的令牌, 不可复用, offset 9`,
    char[1] Reason `拒绝原因, 见 3.2.4.1, offset 23`,
}

// 3.2.5 Type 'E' - Executed Order, PDF p.14-15, 定长 49 字节。
packet OrderExecutedMessage {
    OrderToken OrderToken `订单令牌, offset 9`,
    char[6] Shares `本次成交股数, offset 23`,
    Price Price `成交价 6.4, offset 29`,
    char[1] Liquidity `流动性标志, 见 3.2.5.1, offset 39`,
    MatchNumber MatchNumber `成交匹配号, 买卖双方相同, offset 40`,
}

// 3.2.6 Type 'B' - Broken Trade, PDF p.16, 定长 33 字节。
packet BrokenTradeMessage {
    OrderToken OrderToken `被 break 成交所属订单的令牌, offset 9`,
    MatchNumber MatchNumber `前一 Executed 消息中的匹配号, offset 23`,
    char[1] Reason `break 原因: E=错单 C=协商 S=监管 X=外部, offset 32`,
}

// 3.2.7 Type 'G' - Executed with Reference Price, PDF p.16-17, 定长 60 字节。
packet ExecutedWithReferencePriceMessage {
    OrderToken OrderToken `成交订单的令牌, offset 9`,
    char[6] Shares `本次成交股数, offset 23`,
    Price Price `成交价 6.4, offset 29`,
    char[1] Liquidity `流动性标志, offset 39`,
    MatchNumber MatchNumber `成交匹配号, offset 40`,
    Price ReferencePrice `本次成交关联的参考价, offset 49`,
    char[1] ReferencePriceType `参考价类型, 当前仅 I=日内指示值, offset 59`,
}

// 3.2.8 Type 'F' - Trade Correction, PDF p.17, 定长 50 字节。
// PDF 表格 Timestamp/Type 偏移标注与其它 Outbound 消息相反, 按排版错误处理
// (Timestamp offset 0, Type offset 8)。
packet TradeCorrectionMessage {
    OrderToken OrderToken `成交订单的令牌, offset 9`,
    char[6] Shares `本次成交股数, offset 23`,
    Price Price `成交价 6.4, offset 29`,
    char[1] Liquidity `流动性标志, offset 39`,
    MatchNumber MatchNumber `成交匹配号, offset 40`,
    char[1] Reason `更正原因, 当前仅 N=按 NAV 调整, offset 49`,
}

// =====================================================================
// Dispatchers (方向分发器)
// =====================================================================

// Inbound 分发器: 消息类型字符位于 offset 0。
packet RashInbound {
    char[1] MsgType `消息类型字符`,
    match MsgType as Body {
        "O" : EnterOrderMessage,
        "Q" : EnterOrderWithCrossMessage,
        "X" : CancelOrderMessage,
    },
}

// Outbound 分发器(根): 前 8 字节为 Timestamp, 消息类型字符位于 offset 8。
root packet RashOutbound {
    Timestamp Timestamp `时间戳(毫秒, ET), offset 0`,
    char[1] MsgType `消息类型字符, offset 8`,
    match MsgType as Body {
        "S" : SystemEventMessage,
        "A" : OrderAcceptedMessage,
        "R" : OrderAcceptedWithCrossMessage,
        "C" : OrderCanceledMessage,
        "J" : OrderRejectedMessage,
        "E" : OrderExecutedMessage,
        "B" : BrokenTradeMessage,
        "G" : ExecutedWithReferencePriceMessage,
        "F" : TradeCorrectionMessage,
    },
}
