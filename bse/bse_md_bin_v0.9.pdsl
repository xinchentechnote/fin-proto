options {
    StringPreFixLenType = u16;
    RepeatPreFixSizeType = u16;
    LittleEndian = true;
    JavaPackage = "com.finproto.bjse.md.messages";
    GoPackage = "bjse_md_bin";
    GoModule = "github.com/xinchentechnote/fin-proto-go/bjse-md-bin/messages";
}

MetaData DataField {
    char[20] CompID `接收方或发送方代码`,
    int64 Price `价格，N13(5)`,
    int64 Qty `数量，N15(3)`,
    int64 Amt `金额，N18(3)`,
    int64 SeqNum `消息序号`,
    uint16 Boolean `1=True/Yes,0=False/No`,
    uint32 Length `长度，表示字节为单位的数据长度，正数`,
    int64 LocalTimeStamp `本地时间戳，YYYYMMDDHHMMSSsss（毫秒）`,
    uint32 NumInGroup `重复数，表示重复组的个数，正数`,
    uint32 LocalMktDate `本地市场日期，格式YYYYMMDD`,
    char[8] SecurityID `证券代码，6位数字，前2位空格`,
}

MetaData SessionField {
    uint32 BodyLength `消息体长度`,
    uint32 MsgType `消息类型`,
    uint32 Checksum `校验和`,
    char[20] SenderCompID `发送方代码`,
    char[20] TargetCompID `接收方代码`,
    char[16] Password `密码`,
    char[200] Text `文本信息，可能包含中文字符，表示最多200个字节`,
    int32 HeartBtInt `心跳监测的时间间隔为系统设定值，以秒为单位`,
    char[32] DefaultApplVerID `通信版本号，填写为n.xy，如通信版本号为1.01时，则字段应设置为1.01`,
    int32 SessionStatus `会话状态`,
}

MetaData Bussines{
    char AmountStatus `额度状态`,
    SeqNum ApplBegSeqNum `起始序号`,
    SeqNum ApplEndSeqNum `结束序号`,
    SeqNum ApplLastSeqNum `最后一条行情消息的记录号`,
    SeqNum ApplSeqNum `消息记录号`,
    SeqNum AskApplSeqNum `卖方委托索引`,
    Amt AuctionVolumeTrade `匹配成交成交量`,
    Amt AuctionValueTrade `匹配成交成交金额`,
    SeqNum BidApplSeqNum `买方委托索引`,
    uint16 BidExecInstType `竞买成交方式`,
    uint16 BidTransType `竞买业务类别`,
    uint16 BusinessRejectReason `拒绝原因`,
    char[10] BusinessRejectRefID `被拒绝消息对应的业务层 ID`,
    char[50] BusinessRejectText `拒绝原因说明`,
    uint16 ChannelNo `频道代码`,
    LocalTimeStamp ComplexEventStartTime `冷静期开始时间`,
    LocalTimeStamp ComplexEventEndTime `冷静期结束时间`,
    uint32 ConfirmID `定价行情约定号`,
    char[30] ContactInfo `联系方式`,
    char[12] Contactor `联系人`,
    Boolean EndOfChannel `频道结束标志`,
    char ExecType `执行类型`,
    uint16 ExpirationDays `期限，单位为天数`,
    uint8 ExpirationType `期限类型`,
    char[8] FinancialStatus `证券状态`,
    char[128] Headline `公告标题`,
    Price HighLimitPrice `价格上限`,
    Price LastPx `成交价格`,
    Qty LastQty `成交数量`,
    Price LowLimitPrice `价格下限`,
    Price MarginPrice `达成成交的边际价格`,
    char[8] MarketID `市场代码`,
    char[8] MarketSegmentID `市场板块代码`,
    int64 MDEntryPx `行情条目价格, N18(5)`,
    Qty MDEntrySize `行情条目数量`,
    char[2] MDEntryType `行情条目类别`,
    uint16 MDPriceLevel `买卖盘档位`,
    char[3] MDStreamID `行情类别`,
    Qty MinQty `最低成交数量`,
    char[6] MemberID `交易商代码`,
    char[120] Memo `备注`,
    char[16] NewsID `公告索引/增值信息索引`,
    NumInGroup NoComplexEventTimes `VCM 冷静期个数`,
    NumInGroup NoMDEntries `行情条目个数`,
    NumInGroup NoMDStreamID `行情类别个数`,
    NumInGroup NoOrders `价位揭示委托笔数`,
    NumInGroup NoSubTradingPhaseCodes `细分交易阶段个数`,
    NumInGroup NoSwitch `开关个数`,
    int64 NumberOfOrders `价位总委托笔数`,
    int64 NumTrades `成交笔数`,
    SeqNum OfferApplSeqNum `卖方委托索引`,
    Qty OrderQty `订单数量`,
    char OrdType `订单类型`,
    LocalTimeStamp OrigTime `数据生成时间`,
    Price PreClosePx `昨收价`,
    Amt PosAmt `日中剩余额度`,
    char[10] QuoteID `报价消息编号`,
    char[] RawData `变长二进制数据`,
    char[8] RawDataFormat `二进制数据格式`,
    Length RawDataLength `二进制数据长度`,
    uint32 RefMsgType `被拒绝的消息类型`,
    SeqNum RefSeqNum `引用的消息序号`,
    char[16] RejectText `拒绝原因说明`,
    uint8 ResendStatus `重传状态`,
    uint8 ResendType `重发种类`,
    char[16] SecondaryOrderID `竞买场次编号`,
    char[4] SecurityIDSource `证券代码源`,
    char[40] SecuritySymbol `证券简称`,
    Boolean SecuritySwitchStatus `开关状态`,
    uint16 SecuritySwitchType `开关类别`,
    char SettlPeriod `结算周期`,
    char SettlType `结算方式`,
    char Side `买卖方向`,
    uint32 StockNum `证券只数`,
    char[8] SubTradingPhaseCode `交易方式所处的交易阶段代码`,
    uint16 TemplateID `模板号`,
    Amt ThresholdAmount `每日初始额度`,
    Amt TotalValueTrade `成交总金额`,
    Qty TotalVolumeTrade `成交总量`,
    LocalMktDate TradeDate `交易日期`,
    char[8] TraderCode `交易员代码`,
    char[8] TradingPhaseCode `产品所处的交易阶段代码`,
    char[4] TradingSessionID `交易会话 ID`,
    char[4] TradingSessionSubID `交易会话子 ID`,
    Price TradePrice `成交价格`,
    Qty TradeQty `成交数量`,
    Amt TradeMoney `成交金额（元）`,
    LocalTimeStamp TradeTime `最近成交时间`,
    uint8 TradingType `交易方式`,
    LocalTimeStamp TradSesEndTime `交易会话结束时间`,
    LocalTimeStamp TradSesStartTime `交易会话开始时间`,
    uint16 TradSesStatus `交易会话状态`,
    LocalTimeStamp TransactTime `委托时间`,
    uint16 UserNum `用户数目`,
    char[16] VersionCode `版本代码`,
    uint32 NewsNo `公告序号`,
    uint8 NewsType `公告类型`,
    //TODO miss metadata
    char[8] BidBranchName `买方营业部名称`,
    char[8] OfferBranchName `卖方营业部名称`,
    char SecurityType `证券类型`,
    char NPOrdType `非参与方订单类型`,
    char MMDataType `做市商数据类型`,
    char MMOrdType `做市商订单类型`,
    char[8] SubTradingPhaseCodes `交易方式所处的交易阶段代码`,
}

//登录消息（Logon）
packet Logon {
    SenderCompID,
    TargetCompID,
    HeartBtInt,
    Password,
    DefaultApplVerID,
}

//注销消息（Logout）
packet Logout {
    SessionStatus,
    Text,
}

//心跳消息（Heartbeat）
packet Heartbeat {

}

//频道心跳（301000）
packet ChannelHeartbeat {
    ChannelNo,
    ApplLastSeqNum,
    EndOfChannel,
}

//重传消息（302000）
packet ResendRequest {
    ResendType,
    ChannelNo,
    ApplBegSeqNum,
    ApplEndSeqNum,
    NewsID,
    ResendStatus,
    RejectText,
}


//快照行情频道统计（303000）
packet ChannelStatistics {
    OrigTime,
    ChannelNo,
    repeat NoMDStreamID{
        MDStreamID,
        StockNum,
        TradingPhaseCode,
    },
}

//业务拒绝消息（8）
packet BusinessReject {
    RefSeqNum,
    RefMsgType,
    BusinessRejectRefID,
    BusinessRejectReason,
    BusinessRejectText,
}

//证券实时状态（304000）
packet SecurityStatus {
    OrigTime,
    SecurityID,
    SecurityIDSource,
    SecuritySymbol,
    repeat NoSwitch {
        SecuritySwitchType,
        SecuritySwitchStatus,
    },
}

//公告（305000）
packet Announcement {
    OrigTime,
    ChannelNo,
    NewsID,
    Headline,
    NewsType,
    RawDataFormat,
    RawDataLength,
    RawData,
}

//快照行情
packet SnapshotMarketData {
    OrigTime,
    ChannelNo,
    MDStreamID,
    SecurityID,
    SecurityIDSource,
    TradingPhaseCode,
    PreClosePx,
    NumTrades,
    TotalVolumeTrade,
    TotalValueTrade,
    match MDStreamID as ExtendFields{
        "010" : ExtendMd010,
        "020" : ExtendMd020,
        "030" : ExtendMd030,
    },
}

packet ExtendMd010 {
    repeat NoMDEntries {
        MDEntryType,
        MDEntryPx,
        MDEntrySize,
        MDPriceLevel,
        repeat NoOrders {
            OrderQty,
        },
    },
    repeat NoSubTradingPhaseCodes {
        SubTradingPhaseCodes,
        TradingType,
    },
    AuctionVolumeTrade,
    AuctionValueTrade,
    TradeTime,
}

packet ExtendMd020 {
    repeat NoMDEntries {
        MDEntryType,
        MDEntryPx,
        MDEntrySize,
        MDPriceLevel,
        repeat NoOrders {
            OrderQty,
        },
    },
}
packet ExtendMd030 {
    repeat NoMDEntries {
        MDEntryType,
        MDEntryPx,
    },
}

//逐笔委托行情
packet TickByTickOrderMarketData {
    OrigTime,
    ChannelNo,
    ApplSeqNum,
    MDStreamID,
    SecurityID,
    SecurityIDSource,
    Price,
    OrderQty,
    Side,
    TransactTime,
    match MDStreamID as ExtendFields{
        "011" : ExtendOrdMd011,
        "021" : ExtendOrdMd021,
        "022" : ExtendOrdMd022,
        "023" : ExtendOrdMd023,
        "024" : ExtendOrdMd024,
    },
}

packet ExtendOrdMd011 {
    OrdType,
    SettlType,
    SettlPeriod,
}

packet ExtendOrdMd021 {
    ConfirmID,
}
packet ExtendOrdMd022 {
    MMOrdType,
    MMDataType,
}
packet ExtendOrdMd023 {
    ExpirationDays,
    ExpirationType,
}

packet ExtendOrdMd024 {
    ConfirmID,
    SecurityType,
    NPOrdType,
}

//4.4.5. 逐笔成交行情
packet TickByTickReportMarketData {
    ChannelNo,
    ApplSeqNum,
    MDStreamID,
    SecurityID,
    SecurityIDSource,
    BidApplSeqNum,
    AskApplSeqNum,
    TradePrice,
    TradeQty,
    TradeMoney,
    ExecType,
    TransactTime,
    match MDStreamID as ExtendFields{
        "011" : ExtendReportMd011,
        "012" : ExtendReportMd012,
        "023" : ExtendReportMd023,
        "024" : ExtendReportMd024,
    },
}

packet ExtendReportMd011 {
    SettlPeriod,
    SettlType,
}
packet ExtendReportMd012 {
    SettlPeriod,
    SettlType,
}
packet ExtendReportMd023 {
    BidBranchName,
    OfferBranchName,
}
packet ExtendReportMd024 {
}

root packet BjseMdBinary {
    u32 MsgType `消息类型`,
    u32 BodyLength `消息体长度`,
    match MsgType as Body {
        1 : Logon,
        2 : Logout,
        3 : Heartbeat,
        301000 : ChannelHeartbeat,
        302000 : ResendRequest,
        303000 : ChannelStatistics,
        8 : BusinessReject,
        304000 : SecurityStatus,
        305000 : Announcement,
        [306001,306002,306003] : SnapshotMarketData,
        [307011,307021,307022,307023,307024] : TickByTickOrderMarketData,
        [308011,308012,308023,308024] : TickByTickReportMarketData,
    },
    Checksum,
}
