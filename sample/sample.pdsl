// sample.pdsl is a sample protocol definition file for FinProto.
// It defines various packet structures and their fields, including basic types,
// strings, nested packets, and empty packets.
// protocol definition base on antlr4 :https://github.com/xinchentechnote/fin-protoc/blob/main/grammar/PacketDsl.g4
options {
    StringPrefixLenType = u16;
    ArrayPrefixLenType = u16;
    LittleEndian = true;
    JavaPackage = "com.finproto.sample.messages";
    GoPackage = "sample_bin";
    GoModule = "github.com/xinchentechnote/fin-proto-go/sample-bin/messages";
    FixedStringPadFromLeft = true;
    FixedStringPadChar = '0';
}

// root packet
root packet RootPacket {
    u16 MsgType `msgType`,
    @lengthOf(Payload)
    u32 PayloadLen `length of the payload`,
    match MsgType as Payload {
        1 : BasicPacket,
        2 : StringPacket,
        3 : NestedPacket,
        4 : EmptyPacket,
    },
    @calculatedFrom("CRC32")
    u32 Checksum `校验和`,
}

// BasicPacket is a packet that contains various basic data types.
packet BasicPacket {
    i8 fieldI8,
    i16 fieldI16,
    i32 fieldI32,
    i64 fieldI64,
    char[1] fieldChar,
    u8 fieldU8,
    u16 fieldU16,
    u32 fieldU32,
    u64 fieldU64,
    f32 fieldF32,
    f64 fieldF64,
    repeat i8 fieldI8List,
    repeat i16 fieldI16List,
    repeat i32 fieldI32List,
    repeat i64 fieldI64List,
    repeat char[1] fieldCharList,
    repeat u8 fieldU8List,
    repeat u16 fieldU16List,
    repeat u32 fieldU32List,
    repeat u64 fieldU64List,
    repeat f32 fieldF32List,
    repeat f64 fieldF64List,
}

// StringPacket is a packet that contains various string fields.
// It includes both dynamic and fixed-length strings, as well as lists of these strings.
packet StringPacket {
    string fieldDynamicString,
    char[] fieldDynamicString1,
    char[1] fieldFixedString1,
    char[10] fieldFixedString10,
    @leftPad(' ')
    char[10] fieldFixedString10Pad,
    repeat string fieldDynamicStringList,
    repeat char[] fieldDynamicString1List,
    repeat char[1] fieldFixedString1List,
    repeat char[10] fieldFixedString10List,
    @rightPad('0')
    repeat char[10] fieldFixedString10ListPad,
}

// NestedPacket is a packet that contains a sub-packet and an inner packet.
packet NestedPacket {
    SubPacket SubPacket,
    repeat SubPacket SubPacketList,
    // InnerPacket InnerPacket,
    // The InnerPacket is defined within the NestedPacket, but it can also be defined separately
    InerPacket {
        u32 fieldU32,
        repeat i16 fieldI16List,
    },
}

// SubPacket is a sub-packet used within NestedPacket.
packet SubPacket {
    u32 fieldU32,
    repeat i16 fieldI16List,
}

// EmptyPacket is a packet that contains no fields.
packet EmptyPacket {
}